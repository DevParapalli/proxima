{
  "$description": "Proxima design tokens, W3C design-tokens format. $value is the dark theme (:root in css/proxima.css). $extensions.proxima carries the CSS custom property name and, where the light theme (html.theme-light) overrides the value, the light value. Accent variants mirror html.accent-teal, -ember and -lime.",
  "color": {
    "neutral": {
      "void": { "$type": "color", "$value": "#0A0B12", "$description": "page background", "$extensions": { "proxima": { "css": "--void", "light": "#EDEEF6" } } },
      "abyss": { "$type": "color", "$value": "#06070E", "$description": "the darkest ground, used on the project page", "$extensions": { "proxima": { "css": "--abyss", "light": "#E2E3EF" } } },
      "panel": { "$type": "color", "$value": "#12141F", "$description": "solid panel", "$extensions": { "proxima": { "css": "--panel", "light": "#F7F8FC" } } },
      "panel-2": { "$type": "color", "$value": "#181B2A", "$description": "raised solid panel", "$extensions": { "proxima": { "css": "--panel-2", "light": "#FFFFFF" } } },
      "ink-hi": { "$type": "color", "$value": "#EFF0F8", "$description": "primary text", "$extensions": { "proxima": { "css": "--ink-hi", "light": "#1B1D2E" } } },
      "ink-mid": { "$type": "color", "$value": "#A9ADC7", "$description": "body text", "$extensions": { "proxima": { "css": "--ink-mid", "light": "#4E5270" } } },
      "ink-low": { "$type": "color", "$value": "#666B8A", "$description": "decorative and duplicated text only: 3.5:1 on panel, never the sole carrier of essential copy", "$extensions": { "proxima": { "css": "--ink-low", "light": "#9094B0" } } },
      "hairline": { "$type": "color", "$value": "rgba(255,255,255,.08)", "$description": "standard border", "$extensions": { "proxima": { "css": "--hairline", "light": "rgba(27,29,46,.14)" } } },
      "hairline-soft": { "$type": "color", "$value": "rgba(255,255,255,.05)", "$description": "quiet divider", "$extensions": { "proxima": { "css": "--hairline-soft", "light": "rgba(27,29,46,.07)" } } }
    },
    "glass": {
      "glass-1": { "$type": "color", "$value": "rgba(255,255,255,.03)", "$description": "resting cards, blur 8", "$extensions": { "proxima": { "css": "--glass-1", "light": "rgba(255,255,255,.52)" } } },
      "glass-2": { "$type": "color", "$value": "rgba(255,255,255,.055)", "$description": "raised controls and inputs, blur 18", "$extensions": { "proxima": { "css": "--glass-2", "light": "rgba(255,255,255,.78)" } } },
      "glass-3": { "$type": "color", "$value": "rgba(22,24,38,.72)", "$description": "overlays, save bar, sign-in card, blur 26 plus shadow", "$extensions": { "proxima": { "css": "--glass-3", "light": "rgba(255,255,255,.88)" } } }
    },
    "accent": {
      "indigo": {
        "accent": { "$type": "color", "$value": "#8D8DF5", "$extensions": { "proxima": { "css": "--accent", "light": "#5757D9" } } },
        "accent-deep": { "$type": "color", "$value": "#5757D9", "$extensions": { "proxima": { "css": "--accent-deep", "light": "#4343C4" } } },
        "accent-ink": { "$type": "color", "$value": "#0B0B1C", "$extensions": { "proxima": { "css": "--accent-ink", "light": "#FFFFFF" } } },
        "accent-glow": { "$type": "color", "$value": "rgba(124,124,242,.35)", "$extensions": { "proxima": { "css": "--accent-glow", "light": "rgba(87,87,217,.25)" } } }
      },
      "teal": {
        "accent": { "$type": "color", "$value": "#5FD3C8", "$extensions": { "proxima": { "css": "--accent", "light": "#12837C" } } },
        "accent-deep": { "$type": "color", "$value": "#2B9E95", "$extensions": { "proxima": { "css": "--accent-deep", "light": "#0C6A64" } } },
        "accent-ink": { "$type": "color", "$value": "#04211E", "$extensions": { "proxima": { "css": "--accent-ink", "light": "#FFFFFF" } } },
        "accent-glow": { "$type": "color", "$value": "rgba(80,200,190,.3)", "$extensions": { "proxima": { "css": "--accent-glow", "light": "rgba(18,131,124,.22)" } } }
      },
      "ember": {
        "accent": { "$type": "color", "$value": "#F2A566", "$extensions": { "proxima": { "css": "--accent", "light": "#B05808" } } },
        "accent-deep": { "$type": "color", "$value": "#CE7627", "$extensions": { "proxima": { "css": "--accent-deep", "light": "#8F4508" } } },
        "accent-ink": { "$type": "color", "$value": "#2A1404", "$extensions": { "proxima": { "css": "--accent-ink", "light": "#FFFFFF" } } },
        "accent-glow": { "$type": "color", "$value": "rgba(242,165,102,.3)", "$extensions": { "proxima": { "css": "--accent-glow", "light": "rgba(176,88,8,.22)" } } }
      },
      "lime": {
        "accent": { "$type": "color", "$value": "#CFE763", "$extensions": { "proxima": { "css": "--accent", "light": "#66790A" } } },
        "accent-deep": { "$type": "color", "$value": "#9DBB2E", "$extensions": { "proxima": { "css": "--accent-deep", "light": "#525F00" } } },
        "accent-ink": { "$type": "color", "$value": "#1D2404", "$extensions": { "proxima": { "css": "--accent-ink", "light": "#FFFFFF" } } },
        "accent-glow": { "$type": "color", "$value": "rgba(207,231,99,.25)", "$extensions": { "proxima": { "css": "--accent-glow", "light": "rgba(102,121,10,.2)" } } }
      }
    },
    "state": {
      "mint": {
        "base": { "$type": "color", "$value": "#5EDBA6", "$description": "fine, healthy, done", "$extensions": { "proxima": { "css": "--mint", "light": "#0F8A5C" } } },
        "fill": { "$type": "color", "$value": "rgba(62,199,138,.13)", "$extensions": { "proxima": { "css": "--mint-fill", "light": "rgba(62,199,138,.16)" } } },
        "line": { "$type": "color", "$value": "rgba(94,219,166,.28)", "$extensions": { "proxima": { "css": "--mint-line", "light": "rgba(15,138,92,.3)" } } }
      },
      "amber": {
        "base": { "$type": "color", "$value": "#F5C951", "$description": "look at this soon", "$extensions": { "proxima": { "css": "--amber", "light": "#8F6400" } } },
        "fill": { "$type": "color", "$value": "rgba(245,201,81,.12)", "$extensions": { "proxima": { "css": "--amber-fill", "light": "rgba(245,201,81,.24)" } } },
        "line": { "$type": "color", "$value": "rgba(245,201,81,.26)", "$extensions": { "proxima": { "css": "--amber-line", "light": "rgba(143,100,0,.3)" } } }
      },
      "rose": {
        "base": { "$type": "color", "$value": "#F8929F", "$description": "broken, or a destructive action, and nowhere else", "$extensions": { "proxima": { "css": "--rose", "light": "#C43552" } } },
        "fill": { "$type": "color", "$value": "rgba(248,113,133,.13)", "$extensions": { "proxima": { "css": "--rose-fill", "light": "rgba(248,113,133,.15)" } } },
        "line": { "$type": "color", "$value": "rgba(248,146,159,.3)", "$extensions": { "proxima": { "css": "--rose-line", "light": "rgba(196,53,82,.3)" } } }
      },
      "sky": {
        "base": { "$type": "color", "$value": "#6EC6F5", "$description": "information, in progress", "$extensions": { "proxima": { "css": "--sky", "light": "#1272AE" } } },
        "fill": { "$type": "color", "$value": "rgba(110,198,245,.12)", "$extensions": { "proxima": { "css": "--sky-fill", "light": "rgba(110,198,245,.2)" } } },
        "line": { "$type": "color", "$value": "rgba(110,198,245,.26)", "$extensions": { "proxima": { "css": "--sky-line", "light": "rgba(18,114,174,.3)" } } }
      }
    },
    "chart": {
      "ch-1": { "$type": "color", "$value": "#6A6AE8", "$description": "series 1, follows the accent", "$extensions": { "proxima": { "css": "--ch-1", "light": "#5050D6" } } },
      "ch-2": { "$type": "color", "$value": "#2FA97C", "$extensions": { "proxima": { "css": "--ch-2", "light": "#1F8A63" } } },
      "ch-3": { "$type": "color", "$value": "#B8831F", "$extensions": { "proxima": { "css": "--ch-3", "light": "#8A6200" } } },
      "ch-4": { "$type": "color", "$value": "#D95C6E", "$extensions": { "proxima": { "css": "--ch-4", "light": "#D23B72" } } },
      "ch-5": { "$type": "color", "$value": "#3E9CD6", "$extensions": { "proxima": { "css": "--ch-5", "light": "#2380BC" } } },
      "ch-neutral": { "$type": "color", "$value": "#3A3F58", "$description": "comparison bars", "$extensions": { "proxima": { "css": "--ch-neutral", "light": "#C9CDE0" } } },
      "gridline": { "$type": "color", "$value": "rgba(255,255,255,.05)", "$extensions": { "proxima": { "css": "--gridline", "light": "rgba(27,29,46,.08)" } } },
      "crosshair": { "$type": "color", "$value": "rgba(255,255,255,.18)", "$extensions": { "proxima": { "css": "--crosshair", "light": "rgba(27,29,46,.28)" } } }
    }
  },
  "radius": {
    "r-s": { "$type": "dimension", "$value": "8px", "$extensions": { "proxima": { "css": "--r-s" } } },
    "r-m": { "$type": "dimension", "$value": "12px", "$description": "textareas, inset panels", "$extensions": { "proxima": { "css": "--r-m" } } },
    "r-l": { "$type": "dimension", "$value": "18px", "$description": "standard card", "$extensions": { "proxima": { "css": "--r-l" } } },
    "r-xl": { "$type": "dimension", "$value": "26px", "$extensions": { "proxima": { "css": "--r-xl" } } },
    "r-full": { "$type": "dimension", "$value": "999px", "$description": "the capsule, anything you can tap", "$extensions": { "proxima": { "css": "--r-full" } } }
  },
  "space": {
    "sp-1": { "$type": "dimension", "$value": "4px", "$extensions": { "proxima": { "css": "--sp-1" } } },
    "sp-2": { "$type": "dimension", "$value": "8px", "$extensions": { "proxima": { "css": "--sp-2" } } },
    "sp-3": { "$type": "dimension", "$value": "12px", "$extensions": { "proxima": { "css": "--sp-3" } } },
    "sp-4": { "$type": "dimension", "$value": "16px", "$extensions": { "proxima": { "css": "--sp-4" } } },
    "sp-5": { "$type": "dimension", "$value": "24px", "$extensions": { "proxima": { "css": "--sp-5" } } },
    "sp-6": { "$type": "dimension", "$value": "32px", "$extensions": { "proxima": { "css": "--sp-6" } } },
    "sp-7": { "$type": "dimension", "$value": "48px", "$extensions": { "proxima": { "css": "--sp-7" } } }
  },
  "font": {
    "ui": { "$type": "fontFamily", "$value": ["Outfit", "Segoe UI", "system-ui", "sans-serif"], "$description": "everything, body weight 380", "$extensions": { "proxima": { "css": "--font-ui" } } },
    "serif": { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "one flourish per screen", "$extensions": { "proxima": { "css": "--font-serif" } } },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "Cascadia Code", "Consolas", "monospace"], "$description": "labels, hostnames, timestamps, anything a machine produced", "$extensions": { "proxima": { "css": "--font-mono" } } }
  }
}
